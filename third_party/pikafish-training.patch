+std::string Engine::training_features() const {
+    std::ostringstream out;
+    out << "{\"layerBucket\":" << NN::PSQFeatureSet::make_layer_stack_bucket(pos)
+        << ",\"perspectives\":[";
+
+    const Color perspectives[2] = {pos.side_to_move(), ~pos.side_to_move()};
+    for (int perspectiveIndex = 0; perspectiveIndex < 2; ++perspectiveIndex)
+    {
+        if (perspectiveIndex)
+            out << ',';
+        const Color perspective = perspectives[perspectiveIndex];
+        auto [bucket, mirror, attackBucket] =
+          NN::PSQFeatureSet::make_feature_bucket(perspective, pos);
+
+        NN::PSQFeatureSet::IndexList psq;
+        Bitboard                     pieces = pos.pieces();
+        while (pieces)
+        {
+            const Square square = pop_lsb(pieces);
+            psq.push_back(NN::PSQFeatureSet::make_index(
+              perspective, square, pos.piece_on(square), bucket, mirror));
+        }
+
+        NN::ThreatFeatureSet::IndexList threats;
+        NN::ThreatFeatureSet::append_active_indices(perspective, pos, threats);
+
+        const auto writeIndices = [&out](const auto& indices) {
+            out << '[';
+            for (usize index = 0; index < indices.size(); ++index)
+            {
+                if (index)
+                    out << ',';
+                out << indices[index];
+            }
+            out << ']';
+        };
+
+        out << "{\"color\":\"" << (perspective == WHITE ? "red" : "black")
+            << "\",\"featureBucket\":" << bucket << ",\"attackBucket\":" << attackBucket
+            << ",\"mirror\":" << (mirror ? "true" : "false") << ",\"psq\":";
+        writeIndices(psq);
+        out << ",\"threats\":";
+        writeIndices(threats);
+        out << '}';
+    }
+    out << "]}";
+    return out.str();
+}
+
 const OptionsMap& Engine::get_options() const { return options; }
 OptionsMap&       Engine::get_options() { return options; }
 
